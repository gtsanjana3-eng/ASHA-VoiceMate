# Copy this file to ".env" and put your real values in ".env" (never in this file).
# ".env" is listed in .gitignore, so it will not be uploaded to GitHub.

# Your Gnani API key (create one at https://app.gnani.ai/voice/).
# It is sent only from this server to api.vachana.ai in the X-API-Key-ID header.
GNANI_API_KEY=replace-with-your-gnani-api-key

# Optional: Timbre v3.0 voice for spoken replies. Default: Chetana
# (documented by Gnani as a gentle, empathetic voice for healthcare).
# Other Timbre v3.0 voices: Shivani, Kalpana, Tarika, Lakshmi, Vasudha, Riyaa,
# Avinash, Shubham, Prakash, Devansh, Yashraj, Harshad
# GNANI_TTS_VOICE=Chetana

# Optional: Prisma v3.0 output style. "transcribe" writes numbers as digits
# (best for weights and dates). Other documented values: verbatim, codemix.
# GNANI_STT_FORMAT=transcribe

# Optional: where the SQLite database file is stored.
# ASHA_DB_PATH=data/asha_voicemate.db

# Optional: seconds to wait for Gnani before showing a timeout error.
REQUEST_TIMEOUT_SECONDS=30
